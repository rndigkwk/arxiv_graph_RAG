NEO4J_URI=neo4j+s://<your-instance>.databases.neo4j.io
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=<your-password>
OPENAI_API_KEY=<your-openai-api-key>
# Optional: OPENAI_MODEL=gpt-6-luna

# Optional evaluation cost rates (USD per million tokens); leave unset for null estimates
# EVAL_CHAT_INPUT_USD_PER_1M=
# EVAL_CHAT_OUTPUT_USD_PER_1M=
# EVAL_EMBEDDING_USD_PER_1M=
# EVAL_PRICING_SOURCE=

# Optional operational logging (ADR-053). Default: WARNING to stderr.
# Unknown values fall back to WARNING rather than to DEBUG - a typo must not fill
# the log with data. Lines carry request id / attempt / stage / reason code / seconds,
# never the question, the answer body, the Cypher or the retrieved rows.
# ARXIV_LOG_LEVEL=WARNING
# ARXIV_LOG_FILE=logs/app.log
